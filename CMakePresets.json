{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-toolchain.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug - all boards",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_INTEGRATION": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release - all boards",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_INTEGRATION": "OFF"
      }
    },
    {
      "name": "unit-tests",
      "displayName": "Unit Tests (aarch64-linux, GTest)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/unit-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_C_COMPILER": "clang-22",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-linux-toolchain.cmake",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "unit-tests",
      "configurePreset": "unit-tests"
    }
  ],
  "testPresets": [
    {
      "name": "unit-tests",
      "configurePreset": "unit-tests",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
