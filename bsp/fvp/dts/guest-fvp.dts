/**
 * @file bsp/fvp/dts/guest-fvp.dts
 * @brief Guest device tree for the Arm FVP_Base_RevC-2xAEMvA model.
 * @ingroup bsp
 */

/dts-v1/;
/include/ "guest-base.dtsi"

/ {
	interrupt-parent = <&gic>;

	gic: interrupt-controller@2f000000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		// GICD and the CPU interface only. GICH and GICV are the
		// hypervisor's own frames: a guest that reaches GICH programs the
		// list registers that inject its own interrupts. Stage 2 maps only
		// what this node declares, so declaring them would be both a lie
		// and a request to hand them over.
		reg = <0x0 0x2f000000 0x0 0x10000>,
		      <0x0 0x2c000000 0x0 0x2000>;
	};

	clk_uart: clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	serial@1c090000 {
		compatible = "arm,pl011", "arm,primecell";
		reg = <0x0 0x1c090000 0x0 0x1000>;
		interrupts = <0x0 0x5 0x4>;
		clocks = <&clk_uart &clk_uart>;
		clock-names = "uartclk", "apb_pclk";
	};

	chosen {
		bootargs = "console=ttyAMA0 earlycon=pl011,0x1c090000 root=/dev/ram0 rdinit=/sbin/init";
	};
};
